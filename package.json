{
  "name": "inbox-bodyguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-4721}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-4721}",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
