# Token Factory. Never commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Demo is the default when the key is missing.
# true forces canned judgments even if a key is present.
# false with a key still does not call the API until the flags below are set.
DEMO_MODE=

# Live calls need every one of these, and spend under the hard limit.
# LLM_ENABLED is a kill switch. Unset means off.
LLM_ENABLED=false
BODYGUARD_ALLOW_LIVE=

# Models. Guard and triage default to Nano. Do not point the guard at Super or Ultra.
NEBIUS_GUARD_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_ASSISTANT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional. No dedicated safety model was in the public catalog on 25 Oct 2026.
NEBIUS_SAFETY_MODEL=
# Global completion ceiling. Role caps are tighter: guard 300, triage 500, Super 1000.
NEBIUS_MAX_TOKENS=1024

# Spend ledger. Prices are the 25 Oct 2026 catalog rates, per million tokens.
# Hard AI spend cap in USD for this app (see docs/AI_SPEND_CAP.md). Live calls stop at this total.
AI_SPEND_CAP_USD=0.30
# On Vercel, live calls also need a durable total: UPSTASH_REDIS_REST_* or KV_REST_API_* below,
# or AI_SPEND_ALLOW_EPHEMERAL=1 to accept a per-instance /tmp total that resets on cold start.
AI_SPEND_ALLOW_EPHEMERAL=

# Off unless you mean to send image bytes.
GUARD_VISION=

# fixtures (default) or imap. IMAP also needs ADMIN_SECRET on POST /api/inbox/sync.
INBOX_SOURCE=fixtures
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=

# Header x-admin-secret. Required to pause live calls and to sync IMAP.
# Render marks this sync:false. Do not commit a value.
ADMIN_SECRET=

# Signs the ib-session cookie. Unset uses a process-local secret, so restarts mint new sessions.
SESSION_SECRET=
# Set to 1 only on HTTPS. Local Playwright uses http, so leave this unset there.
COOKIE_SECURE=

# Public demo refuses IMAP even if the other flags are set. A private mailbox needs PUBLIC_DEMO=false.
PUBLIC_DEMO=true

# Comma-separated browser origins allowed to call the API. Empty means same origin only.
CORS_ORIGINS=
# Set to 1 only behind a trusted proxy (Render). The limiter then uses the right-most X-Forwarded-For hop.
TRUST_PROXY=

# Optional spend total that survives an ephemeral disk. Leave both pairs empty in the demo.
# If a pair is set and the store is unreachable, live calls fail closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SQLite file. The completion cache is the llm_cache table in this file.
# Render's free plan has no disk. Use /tmp/bodyguard.db there.
BODYGUARD_DB=data/bodyguard.db
# Unused. Kept so older notes do not point at a missing file.
BODYGUARD_CACHE_PATH=

# Load test only. Never set this on a public host. Skips the per-IP limit.
# BODYGUARD_RELAX_LIMITS=

# Only if the UI is hosted apart from the API. These are URLs, not secrets.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4721
