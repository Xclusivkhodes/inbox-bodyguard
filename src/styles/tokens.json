      "md": "0 1px 2px rgba(9,9,11,0.05), 0 4px 12px -2px rgba(9,9,11,0.08)",
      "lg": "0 2px 4px rgba(9,9,11,0.04), 0 12px 32px -8px rgba(9,9,11,0.14)",
      "xl": "0 4px 8px rgba(9,9,11,0.04), 0 24px 64px -16px rgba(9,9,11,0.22)"
    },
    "dark": {
      "xs": "0 1px 2px rgba(0,0,0,0.4)",
      "sm": "0 1px 2px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.03)",
      "md": "0 4px 12px -2px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.04)",
      "lg": "0 12px 32px -8px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.05)",
